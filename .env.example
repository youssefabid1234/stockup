# ─────────────────────────────────────────────────────────────────────────────
# Voice ERP kit — the ONE config file for api, ai and web (Docker or local).
# Copy to .env (`make setup` does it), fill in your keys, restart (`make restart`).
# Everything works with the mock providers: no key needed to start.
# ─────────────────────────────────────────────────────────────────────────────

# ── Your company's data ──
# Your team zip ships it in ./data (seed/ + context/). Relative paths are resolved from this repo's root.
DATA_DIR=./data

# ── Ports on your machine ──
# ERP UI → http://localhost:5173
WEB_PORT=5173
# ERP REST API (+ /api/events/stream)
API_PORT=4000
# AI service: /chat, /command, WS /voice
AI_PORT=4100
# Where the AI service reaches the ERP (local mode; Docker sets it for you)
ERP_API_URL=http://localhost:4000

# ── LLM ──
# provider: openai | anthropic | gemini | openai-compatible | mock
#   openai-compatible = any OpenAI-style endpoint (Groq, Together, vLLM, Ollama…): set LLM_BASE_URL
LLM_PROVIDER=mock
# Anthropic models: claude-sonnet-5-5 (default, balanced) · claude-haiku-5-5 (fastest, cheapest) · claude-opus-5-5 (smartest, slower)
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=
# Anthropic only (output_config.effort): low | medium | high — low keeps voice latency down; empty = model default
LLM_EFFORT=low
# max model ↔ tool round-trips per turn
AGENT_MAX_STEPS=8

# ── Jev (TypeSafe AI decision model) — optional, used NEXT to the LLM, not instead of it ──
# Not a chat model: it answers typed questions (choice / score / yes-no) with probabilities, fast.
# For routing, "which product did the caller mean", yes/no confirmation… See apps/ai/README.md "Jev".
# Empty key → get_jev_client() returns None and nothing changes.
JEV_API_KEY=
JEV_BASE_URL=https://api.typesafe.ai
JEV_MODEL=jev-latest

# ── Speech-to-text ── provider: deepgram | soniox | gradium | openai | mock
#   deepgram  model nova-3 (default; French via STT_LANGUAGE=fr)        https://console.deepgram.com
#   soniox    model stt-rt-v6 (default; real-time WebSocket, webm OK)   https://console.soniox.com
#   gradium   model default (browser webm is re-wrapped to ogg; Safari mp4 not accepted)  https://gradium.ai
#   openai    model gpt-4o-mini-transcribe
# The browser records audio/webm;codecs=opus: all four accept it.
STT_PROVIDER=mock
STT_API_KEY=
STT_MODEL=
STT_LANGUAGE=fr

# ── Text-to-speech ── provider: elevenlabs | gradium | openai | mock (mock = the browser speaks)
#   elevenlabs  model eleven_flash_v2_5 (default, ~100 ms; eleven_v4_turbo = more expressive)
#               voice JBFqnCBsd6RMkjVDRZzb (default, multilingual) — pick a French voice in your ElevenLabs library
#   gradium     model default; voice F7Iib4MAyHIRed0x (default: Armand, fr-FR, masculine)
#               other fr-FR voices: 0fvH6XAKvA748v2v (Tiphaine), vMYQUSzm6GRkJX6d (Olivier), J4XbCGPYNMigXcfZ (Amélie)
#   openai      model gpt-4o-mini-tts, voice alloy
# Every provider streams mp3 to the browser (Gradium's PCM is encoded to mp3 on the fly).
TTS_PROVIDER=mock
TTS_API_KEY=
TTS_MODEL=
TTS_VOICE=
TTS_LANGUAGE=fr
