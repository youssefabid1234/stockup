# ─────────────────────────────────────────────────────────────────────────────
# Voice ERP kit — the ONE config file for api, ai and web (Docker or local).
# Copy to .env (`make setup` does it), fill in your keys, restart (`make restart`).
# Everything works with the mock providers: no key needed to start.
# ─────────────────────────────────────────────────────────────────────────────

# ── Your company's data ──
# Your team zip ships it in ./data (seed/ + context/). Relative paths are resolved from this repo's root.
DATA_DIR=./data

# ── Ports on your machine ──
# ERP UI → http://localhost:5173
WEB_PORT=5173
# ERP REST API (+ /api/events/stream)
API_PORT=4000
# AI service: /chat, /command, WS /voice
AI_PORT=4100
# Where the AI service reaches the ERP (local mode; Docker sets it for you)
ERP_API_URL=http://localhost:4000

# ── LLM ──
# provider: openai | anthropic | gemini | openai-compatible | mock
#   openai-compatible = any OpenAI-style endpoint (Groq, Together, vLLM, Ollama…): set LLM_BASE_URL
LLM_PROVIDER=mock
# Anthropic models: claude-sonnet-5-5 (default, balanced) · claude-haiku-5-5 (fastest, cheapest) · claude-opus-5-5 (smartest, slower)
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=
# Anthropic only (output_config.effort): low | medium | high — low keeps voice latency down; empty = model default
LLM_EFFORT=low
# max model ↔ tool round-trips per turn
AGENT_MAX_STEPS=8

# ── Jev (TypeSafe AI decision model) — optional, used NEXT to the LLM, not instead of it ──
# Not a chat model: it answers typed questions (choice / score / yes-no) with probabilities, fast.
# For routing, "which product did the caller mean", yes/no confirmation… See apps/ai/README.md "Jev".
# Empty key → get_jev_client() returns None and nothing changes.
JEV_API_KEY=
JEV_BASE_URL=https://api.typesafe.ai
JEV_MODEL=jev-latest

# ── Speech-to-text ── provider: deepgram | soniox | gradium | openai | mock
#   deepgram  model nova-3 (default; French via STT_LANGUAGE=fr)        https://console.deepgram.com
#   soniox    model stt-rt-v6 (default; real-time WebSocket, webm OK)   https://console.soniox.com
#   gradium   model default (browser webm is re-wrapped to ogg; Safari mp4 not accepted)  https://gradium.ai
#   openai    model gpt-4o-mini-transcribe
# The browser records audio/webm;codecs=opus: all four accept it.
STT_PROVIDER=mock
STT_API_KEY=
STT_MODEL=
STT_LANGUAGE=fr

# ── Text-to-speech ── provider: elevenlabs | gradium | openai | mock (mock = the browser speaks)
#   elevenlabs  model eleven_flash_v2_5 (default, ~100 ms; eleven_v4_turbo = more expressive)
#               voice JBFqnCBsd6RMkjVDRZzb (default, multilingual) — pick a French voice in your ElevenLabs library
#   gradium     model default; voice F7Iib4MAyHIRed0x (default: Armand, fr-FR, masculine)
#               other fr-FR voices: 0fvH6XAKvA748v2v (Tiphaine), vMYQUSzm6GRkJX6d (Olivier), J4XbCGPYNMigXcfZ (Amélie)
#   openai      model gpt-4o-mini-tts, voice alloy
# Every provider streams mp3 to the browser (Gradium's PCM is encoded to mp3 on the fly).
TTS_PROVIDER=mock
TTS_API_KEY=
TTS_MODEL=
TTS_VOICE=
# team 12: default voice = « Lucie » (native French, customer service) on eleven_v4_turbo (~200-370 ms). Other French
# voices of the team's ElevenLabs library: Jade 3C1zYzXNXNzrB66ON8rj · Émilie fBpCO0Kf0krKLYGOu65w · Chloé Cy2zXKmu2kQeAuze0rzV.
# A voice missing from your key's library falls back to a premade one (no silence).
TTS_LANGUAGE=fr

# ── Team 12 switches (apps/ai/app/team_flags.py, docs/team/interfaces.md) ── off by default; 1 = on, then restart the AI service
TEAM_FILLERS=4           # 0 = off, 1 = phrases + keyboard, 2 = fast restatement, 3 = both, 4 = zéro silence (the agent opens the call, « d'accord, je regarde ça » at once, typing until the answer)
TEAM_ORCHESTRATOR=1      # Youssef + Amine K.: the ERP is checked in parallel while the agent says « je regarde »
TEAM_PRELOAD=1           # Youssef: caller ID + caller sheet loaded before the call (measured: 1st turn -3 to -4 s)
TEAM_PRODUCT_INSIGHT=1   # Youssef: one tool for stock + price + substitutes + promo (measured: S05 1st turn 6.2 -> 3.9 s)
TEAM_ORDER_RULES=1       # Amine Khalil: "la commande juste" rules (ON: S01 S02 S03 S05 S07 S30 S31 S32 pass)
TEAM_SALES_RULES=1       # Daycem: "le bon vendeur" rules (ON: S04 S40 S41 S42 pass, S05 3/4; demo promo: scripts/setup_demo_data.py after each reset)
TEAM_ROUTER=1            # Amine Khalil: simple replies (« c'est bon, validez », « merci ») → fast model (TEAM_FAST_MODEL), 2-3× faster; the rest → LLM_MODEL
TEAM_SLIM_PROMPT=1       # Amine Khalil: only the essential sections of data/context in the prompt (-64 % context, -37 % tokens per model call)
TEAM_FAST_MODEL=claude-haiku-5-5

# English ERP data (data/seed_en, committed, made by scripts/translate_seed.py from data/seed). Uncomment once the
# agent's prompts are in English too, then: make restart && make reset
# SEED_DIR_NAME=seed_en

# ── Essai voix avant/après (Mohamed Amine) ──
# Dans .env, remplace les valeurs existantes ci-dessus ou ajoute les lignes absentes.
# Garde les clés Soniox et ElevenLabs de l'équipe dans .env.
# STT_PROVIDER=soniox
# TTS_PROVIDER=elevenlabs
# TEAM_FILLERS=3
#
# Joue la même réplique avec TEAM_FILLERS=0, 1, 2 puis 3, dans une nouvelle session à chaque essai.
# Avec 1, 2 ou 3, la civilité facultative du formulaire prépare « Bonjour Madame » ou « Bonjour Monsieur ».
# Sans civilité, la salutation est « Bonjour ».
# Les modes 2 et 3 utilisent TEAM_FAST_MODEL chez le fournisseur LLM_PROVIDER, avec la même clé.
# Le mode 3 joue le clavier pendant la préparation de la reprise.
# TEAM_ORCHESTRATOR peut rester activé. Utilise une synthèse vocale MP3 (ElevenLabs, par exemple).
# Après chaque changement, relance le service IA (Docker : make restart).

# Suggestions personnalisées et simulation d’appels sortants (page Voix).
TEAM_RECOMMENDATIONS=1
TEAM_OUTBOUND_DEMO=1
TEAM_OUTBOUND_RING_SECONDS=10
