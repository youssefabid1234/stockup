{
  "id": "S33",
  "owner": "amine-khalil",
  "title": "A qualified yes changes the order",
  "why": "Apply the correction and read it back before accepting a later confirmation.",
  "client": "cli_0001",
  "turns": [
    {
      "say": "Hi, Nadine from Sarrailh. Ten sacks of traditional flour for Thursday.",
      "expect": {
        "tools_any": [
          "create_draft_order",
          "place_order"
        ],
        "tools_none": [
          "confirm_order"
        ],
        "says_any": [
          "10",
          "ten"
        ]
      }
    },
    {
      "say": "Yes, but make it twelve.",
      "expect": {
        "tools_any": [
          "update_order_line",
          "confirm_order",
          "place_order"
        ],
        "says_any": [
          "12",
          "twelve"
        ]
      }
    },
    {
      "say": "Yes, that's right. Please confirm.",
      "expect": {
        "tools_any": [
          "confirm_order"
        ]
      }
    }
  ]
}
