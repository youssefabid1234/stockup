        "tools_none": [
          "confirm_order"
        ],
        "says_any": [
          "tradi",
          "traditional",
          "flour"
        ],
        "says_none": [
          "10 kilos",
          "ten kilos"
        ]
      }
    },
    {
      "say": "Yes, that's right. Please confirm.",
      "expect": {
        "tools_any": [
          "confirm_order"
        ]
      }
    }
  ]
