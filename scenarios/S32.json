{
  "id": "S32",
  "owner": "amine-khalil",
  "title": "Change a quantity and remove a line",
  "why": "Apply both changes to the same order.",
  "client": "cli_0001",
  "turns": [
    {
      "say": "Hi, it's Nadine from Sarrailh. Ten sacks of traditional flour and three sacks of rye for Thursday.",
      "expect": {
        "tools_any": [
          "create_draft_order",
          "place_order"
        ],
        "tools_none": [
          "confirm_order"
        ],
        "says_any": [
          "10",
          "ten"
        ]
      }
    },
    {
      "say": "Actually, make that fifteen sacks of traditional flour and take off the rye.",
      "expect": {
        "tools_any": [
          "update_order_line",
          "remove_order_line",
          "place_order"
        ],
        "tools_none": [
          "create_draft_order",
          "confirm_order"
        ],
        "says_any": [
          "15",
          "fifteen"
        ]
      }
    },
    {
      "say": "Yes, please confirm.",
      "expect": {
        "tools_any": [
          "confirm_order"
        ],
        "tools_none": [
          "create_draft_order"
        ]
      }
    }
  ]
}
