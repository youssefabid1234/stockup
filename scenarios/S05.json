{
  "id": "S05",
  "owner": "daycem",
  "title": "Pétrin de Colomiers : AOP en rupture → proposer et argumenter le 82 %, puis accord",
  "why": "Intelligent + naturel : remplaçant proposé et argumenté (prix, usage), jamais sans accord ; c'est la scène du CTO",
  "client": "cli_0021",
  "turns": [
    {
      "say": "Bonjour, Le Pétrin de Colomiers. Je voudrais 3 cartons de tourage AOP pour mercredi.",
      "expect": {
        "tools_none": [
          "confirm_order"
        ],
        "says_any": [
          "82",
          "quatre-vingt-deux"
        ]
      }
    },
    {
      "say": "Ah. Et il est à combien, le 82 ?",
      "expect": {
        "tools_any": [
          "get_price",
          "product_insight",
          "quote_line"
        ],
        "says_any": [
          "euro",
          "€"
        ]
      }
    },
    {
      "say": "Bon d'accord, mettez-moi le 82 alors.",
      "expect": {
        "tools_any": [
          "create_draft_order",
          "add_order_line"
        ],
        "tools_none": [
          "confirm_order"
        ]
      }
    },
    {
      "say": "Oui c'est bon.",
      "expect": {
        "tools_any": [
          "confirm_order"
        ]
      }
    }
  ]
}
